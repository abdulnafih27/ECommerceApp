# Database connection
SA_PASSWORD=ReplaceWithYourStrongSqlPassword
ConnectionStrings__DefaultConnection=Server=db,1433;Database=ECommerceDb;User Id=sa;Password=ReplaceWithYourStrongSqlPassword;TrustServerCertificate=True

# JWT
JWT_KEY=ReplaceWithYourLongRandomSecretKey
JWT_ISSUER=http://localhost:5298
JWT_AUDIENCE=http://localhost:5298
JWT_EXPIRY_MINUTES=60

# Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ReplaceWithYourStrongAdminPassword

# Cors
CORS_ALLOWED_ORIGINS__0=http://localhost:5173